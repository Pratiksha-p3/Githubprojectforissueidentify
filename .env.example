# Copy this file to .env and fill in real values. Nothing here is read by
# Stage 0 yet — this documents the full set of variables the project will
# grow into using stage by stage, so each later stage adds behavior behind
# an already-known name instead of a new ad-hoc one.

# ── LLM provider (wired in Stage 2) ─────────────────────────────────────
LLM_PROVIDER=groq          # groq | openai | anthropic
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
REVIEW_MODEL=llama-3.1-8b-instant
MAX_REVIEW_TOKENS=4000

# ── GitHub App (wired in Stage 5) ───────────────────────────────────────
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_PATH=secrets/github_app.pem
GITHUB_WEBHOOK_SECRET=
GITHUB_TOKEN=

# ── GitLab (optional, wired in Stage 5) ─────────────────────────────────
GITLAB_TOKEN=
GITLAB_WEBHOOK_SECRET=

# ── Async queue: Celery + Redis (wired in Stage 4) ──────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── State / audit history: Postgres (wired in Stage 4/8/10) ─────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_code_review

# ── RAG / vector store (wired in Stage 6) ───────────────────────────────
CHROMA_PERSIST_DIR=./vectordb/chroma_data
MIN_SIMILARITY_SCORE=0.30
TOP_K_RETRIEVAL=5

# ── Enrichment: NVD / OSV (wired in Stage 7) ────────────────────────────
NVD_API_KEY=

# ── Notifications (wired in Stage 9) ────────────────────────────────────
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
JIRA_BASE_URL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=

# ── Secrets backend (wired in Stage 10) ─────────────────────────────────
SECRETS_BACKEND=env        # env | azure_keyvault
AZURE_KEYVAULT_URL=

# ── Monitoring (wired in Stage 14) ──────────────────────────────────────
METRICS_ENABLED=false
